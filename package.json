{
  "name": "@designofadecade/salesforce-marketing-cloud",
  "version": "2.5.2",
  "description": "Type-safe TypeScript SDK for Salesforce Marketing Cloud (SFMC) — OAuth 2.0 auth, Data Extensions, Content Assets and Automation Studio over the REST and SOAP APIs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "salesforce",
    "salesforce-marketing-cloud",
    "marketing-cloud",
    "sfmc",
    "sfmc-api",
    "exacttarget",
    "marketing-automation",
    "data-extensions",
    "automation-studio",
    "content-builder",
    "rest-api",
    "soap-api",
    "oauth2",
    "sdk",
    "api-client",
    "typescript",
    "typescript-sdk",
    "nodejs",
    "esm"
  ],
  "author": "Design of a Decade <info@designofadecade.com>",
  "license": "MIT",
  "dependencies": {
    "soap": "^1.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.2.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/designofadecade/salesforce-marketing-cloud.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "CHANGELOG.md"
  ]
}
